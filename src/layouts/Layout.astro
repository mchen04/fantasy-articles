---
import '@fontsource/anton/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import '../styles/global.css';
import Mark from '../components/art/Mark.astro';
interface Props {
  title: string;
  description: string;
  active?: 'home' | 'archive' | 'about';
  article?: { published: string; author: string };
  noindex?: boolean;
}
const { title, description, active, article, noindex = false } = Astro.props;
const site = 'DNP: Did Not Plan';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social.png', Astro.site);
const nav = [
  { href: '/', label: 'Front page', key: 'home' },
  { href: '/archive/', label: 'Find a week', key: 'archive' },
  { href: '/about/', label: 'About DNP', key: 'about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site ? `${site} | The NBA Redraft league's petty paper of record` : `${title} | DNP`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b0b57" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="DNP: Did Not Plan" href="/rss.xml" />
    <meta property="og:site_name" content={site} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="DNP: Did Not Plan. A basketball crossed out by an acid lime slash on purple, with the words: the NBA Redraft league's petty paper of record." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={`${article.published}T00:00:00Z`} />}
    {article && <meta property="article:author" content={article.author} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the reading</a>
    <header class="masthead on-dark">
      <p class="ticker wrap"><span>Vol. 1</span><span>NBA Redraft league</span><span class="ticker-extra">The petty paper of record</span><span>Allegedly</span></p>
      <div class="masthead-row wrap">
        <a class="logo" href="/" aria-label="DNP: Did Not Plan, front page">
          <Mark size={46} class="logo-mark" />
          <span class="logo-words" aria-hidden="true"><span class="logo-dnp">DNP</span><span class="logo-full">Did Not Plan</span></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer on-dark">
      <div class="wrap footer-grid">
        <p class="footer-word" aria-hidden="true">DNP</p>
        <div class="footer-copy">
          <p class="footer-lede">DNP: Did Not Plan is the blog of one NBA Redraft league. Weekly recaps are filed only after the week is verified.</p>
          <p class="footer-fine">Independent. Not affiliated with the NBA or any fantasy platform. No league results were invented in the making of this website.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/archive/">Every week</a>
          <a href="/about/#house-rules">House rules</a>
          <a href="/rss.xml">RSS feed</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
