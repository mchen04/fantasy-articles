---
import Archive from '../../../../components/Archive.astro';
import { allArticles, editions, isRecap } from '../../../../lib/articles';
export async function getStaticPaths() {
  return editions(await allArticles()).filter(({ article }) => isRecap(article)).map(({ article }) => ({ params: { season: article.data.season, kind: 'recaps', week: `week-${article.data.week}` }, props: { season: article.data.season, week: article.data.week, kind: 'league-week' as const } }));
}
---
<Archive {...Astro.props} />
