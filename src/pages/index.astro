---
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/art/HeroArt.astro';
import EmptyBench from '../components/art/EmptyBench.astro';
import SealedBoard from '../components/art/SealedBoard.astro';
import Tape from '../components/Tape.astro';
import Filing from '../components/Filing.astro';
import { allArticles, editions, isRecap, readingTime, displayDate, kindLabel, editionLabel, docketNumber, seasonLabel, type Article } from '../lib/articles';
const articles = await allArticles();
const recaps = articles.filter(isRecap).sort((a, b) => b.data.season.localeCompare(a.data.season) || b.data.week - a.data.week);
const latestRecap: Article | undefined = recaps[0];
const lead = articles[0];
const more = articles.filter((article) => article.id !== lead.id).slice(0, 4);
const weeks = editions(articles).filter((group) => isRecap(group.article)).slice(0, 6);
---
<Layout title="DNP: Did Not Plan" description="DNP: Did Not Plan is the petty paper of record for one NBA Redraft league. Weekly recaps filed only after each matchup week is verified." active="home">
  <section class="front wrap" aria-labelledby="front-heading">
    <div class="front-copy">
      <p class="kicker"><span class="flag">{latestRecap ? 'Verdict!' : 'Extra!'}</span><span>{latestRecap ? `${seasonLabel(latestRecap.data.season)} · Week ${latestRecap.data.week} on the record` : `Opening edition · ${seasonLabel(lead.data.season)}`}</span></p>
      {latestRecap
        ? <h1 id="front-heading">Week {latestRecap.data.week} has been <mark>ruled on.</mark></h1>
        : <h1 id="front-heading">Court is in session. <mark>Nothing</mark> has happened yet.</h1>}
      <p class="front-dek">The petty paper of record for one NBA Redraft league. Weekly rulings, filed only after each matchup week is verified. No invented scores. No names dragged. No mercy for bad benches, eventually.</p>
    </div>
    <figure class="front-art">
      <HeroArt verdicts={Boolean(latestRecap)} />
      <figcaption>Courtroom sketch. No basketballs were convicted.</figcaption>
    </figure>
  </section>

  <section class="lead wrap" aria-labelledby="lead-heading">
    <p class="lead-bar"><span>Top filing</span><span>{docketNumber(lead)}</span></p>
    <div class="lead-body">
      <p class="lead-code" aria-hidden="true">{isRecap(lead) ? `W${lead.data.week}` : '§0'}</p>
      <div>
        <p class="filing-meta"><span class:list={['tag', isRecap(lead) ? 'tag-recap' : 'tag-note']}>{kindLabel(lead)}</span><span>{isRecap(lead) ? editionLabel(lead) : 'Not a matchup week'}</span><span><time datetime={lead.data.published}>{displayDate(lead.data.published)}</time> · {readingTime(lead)} min read</span></p>
        <h2 id="lead-heading"><a href={`/articles/${lead.data.slug}/`}>{lead.data.title}</a></h2>
        <p class="lead-dek">{lead.data.description}</p>
        <a class="sticker-button" href={`/articles/${lead.data.slug}/`} aria-label={`Read the filing: ${lead.data.title}`}>Read the filing <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Tape />

  <div class="split wrap">
    <section class="docket-preview" aria-labelledby="docket-heading">
      <p class="section-kicker">Week by week</p>
      <h2 id="docket-heading">The weekly docket</h2>
      {weeks.length
        ? <ol class="week-list">{weeks.map(({ article, path, entries }) => <li><a href={path}><span class="week-code" aria-hidden="true">W{String(article.data.week).padStart(2, '0')}</span><span class="week-text"><strong>Week {article.data.week}: {article.data.edition}</strong><span>{seasonLabel(article.data.season)} · {entries.length} {entries.length === 1 ? 'filing' : 'filings'}</span></span></a></li>)}</ol>
        : <div class="empty-docket"><EmptyBench /><p><strong>No matchup week has been filed.</strong> Week 1 lands here on its own once its results are verified. The court does not pre-print verdicts.</p></div>}
      <a class="text-link" href="/archive/">{weeks.length ? 'Open the full docket' : 'See the (very short) docket'} <span aria-hidden="true">→</span></a>
    </section>
    <section class="board" aria-labelledby="board-heading">
      <p class="section-kicker">The standings board</p>
      <h2 id="board-heading">{latestRecap ? 'Read the table in the latest recap' : 'Sealed until verified'}</h2>
      {latestRecap
        ? <><p class="board-copy">DNP prints standings only inside a verified weekly recap. Anything the week's data did not verify stays marked unknown, never zero.</p><a class="sticker-button" href={`/articles/${latestRecap.data.slug}/`}>Week {latestRecap.data.week} recap <span aria-hidden="true">→</span></a></>
        : <><SealedBoard /><p class="board-copy">DNP prints standings only from verified weekly data, inside that week's recap. Unknown stays unknown. It never becomes a zero.</p></>}
    </section>
  </div>

  {more.length > 0 && (
    <section class="more wrap" aria-labelledby="more-heading">
      <h2 id="more-heading" class="section-title">Also on file</h2>
      <ol class="filings">{more.map((article) => <Filing article={article} />)}</ol>
    </section>
  )}

  <section class="orders on-dark" aria-labelledby="orders-heading">
    <div class="wrap">
      <p class="section-kicker">Standing orders of the court</p>
      <h2 id="orders-heading">Four rules. No appeals.</h2>
      <ol class="orders-list">
        <li><span class="order-no" aria-hidden="true">§1</span><h3>Verified or it didn't happen.</h3><p>Every weekly recap is checked before it is filed. Each one records who verified it and when.</p></li>
        <li><span class="order-no" aria-hidden="true">§2</span><h3>Teams, not people.</h3><p>No manager names, handles, or private league links. Rosters can be roasted. People stay anonymous.</p></li>
        <li><span class="order-no" aria-hidden="true">§3</span><h3>Unknown is not zero.</h3><p>A missing number stays missing, and the page says so out loud.</p></li>
        <li><span class="order-no" aria-hidden="true">§4</span><h3>The robot testifies.</h3><p>The DNP Desk writes with AI assistance and discloses it on every filing.</p></li>
      </ol>
      <a class="text-link" href="/about/">Read the full house rules <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
