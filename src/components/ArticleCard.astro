---
import { readingTime, editionLabel, type Article } from '../lib/articles';
interface Props { article: Article; featured?: boolean; archive?: boolean }
const { article, featured = false, archive = false } = Astro.props;
const { data } = article;
---
<article class:list={['article-card', { featured }]} data-article data-season={data.season} data-week={data.week} data-type={data.type} data-kind={data.editionKind} data-search={`${data.title} ${data.description} ${data.topic}`.toLowerCase()}>
  <div class="card-meta"><span class="content-kind">{data.type === 'guide' ? 'Strategy guide' : 'Verified recap'}</span><span>{data.topic}</span></div>
  <h3><a href={`/articles/${data.slug}/`} data-article-link={archive || undefined}>{data.title}</a></h3>
  <p>{data.description}</p>
  <div class="card-bottom"><span>{editionLabel(article)}</span><span>{readingTime(article)} min read</span></div>
</article>
