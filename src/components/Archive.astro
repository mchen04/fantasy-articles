---
import Layout from '../layouts/Layout.astro';
import ArticleCard from './ArticleCard.astro';
import { allArticles, editions, editionLabel } from '../lib/articles';
interface Props { season?: string; week?: number; kind?: string }
const { season = '', week, kind = '' } = Astro.props;
const articles = await allArticles();
const groups = editions(articles);
const seasons = [...new Set(articles.map((article) => article.data.season))].sort().reverse();
const initial = groups.find((group) => group.article.data.season === season && group.article.data.week === week && group.article.data.editionKind === kind);
---
<Layout title={initial ? `${editionLabel(initial.article)}: ${initial.article.data.edition}` : 'Article archive'} description="Browse Baseline by season, editorial week, or article type. Find NBA redraft strategy guides and verified league recaps in one archive." active="archive">
  <section class="archive-header wrap"><p class="section-label">NBA redraft library</p><h1>The archive</h1><p>A whole season of decisions. Find the guide you need.</p></section>
  <div class="archive-layout wrap">
    <aside class="archive-sidebar">
      <form id="archive-filters" action="/archive/" method="get" data-initial-season={season} data-initial-week={week ?? ''} data-initial-kind={kind}>
        <h2>Find an article</h2>
        <div class="filter-field search-field"><label for="search">Search the archive</label><input type="search" id="search" name="q" placeholder="Try draft or roster" maxlength="100" /></div>
        <div class="filter-field"><label for="season">Season</label><select id="season" name="season"><option value="">All seasons</option>{seasons.map((value) => <option value={value} selected={value === season}>{value.replace('-', '–')}</option>)}</select></div>
        <div class="filter-field"><label for="week">Week / guide edition</label><select id="week" name="edition"><option value="">All weeks &amp; editions</option>{groups.map(({ article }) => <option value={`${article.data.season}:${article.data.editionKind}:${article.data.week}`} selected={article.data.season === season && article.data.week === week && article.data.editionKind === kind}>{article.data.season} · {editionLabel(article)}: {article.data.edition}</option>)}</select></div>
        <div class="filter-field"><label for="type">Article type</label><select id="type" name="type"><option value="">All articles</option><option value="guide">Strategy guides</option><option value="recap">League recaps</option></select></div>
        <div class="filter-actions"><button class="button primary" type="submit">Apply filters</button><a href="/archive/" id="clear-filters">Reset</a></div>
      </form>
      <p class="archive-context">Guide editions are editorial reading groups, not NBA game weeks. All starter guides publish October 9, 2026.</p>
      <noscript><p>Enable JavaScript to filter this list. All articles and edition links remain available below.</p></noscript>
    </aside>
    <section class="archive-results" aria-label="Articles">
      <div class="results-header"><p id="results-count" role="status" aria-live="polite">{articles.length} articles across {groups.length} editions</p><span>Newest edition first</span></div>
      <div id="empty-results" class="empty-state" hidden><h2 id="empty-title">No articles match</h2><p id="empty-description">Try a different search or reset the filters.</p><a href="/archive/" class="text-link" id="empty-reset">Show all articles</a></div>
      {groups.map(({ article, path, entries }) => <section class="archive-group" data-group data-season={article.data.season} data-kind={article.data.editionKind} data-week={article.data.week}><div class="group-heading"><div><p>{article.data.season.replace('-', '–')} / {editionLabel(article)}</p><h2><a href={path}>{article.data.edition}</a></h2></div><a class="edition-permalink" href={path} aria-label={`Direct link to ${editionLabel(article)}`}>Edition link <span aria-hidden="true">↗</span></a></div><div class="archive-articles">{entries.map((entry) => <ArticleCard article={entry} archive />)}</div></section>)}
    </section>
  </div>
  <script src="../scripts/archive.ts"></script>
</Layout>
